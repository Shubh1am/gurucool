# Copy this to `.env` and fill values. Keep this file out of source control.
# Example `.env` values for local development. Replace placeholders with real keys.
OPENAI_API_KEY=your_openai_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=us-west1-gcp
PINECONE_INDEX_NAME=ghar-ka-guru-index

# Local Postgres (docker-compose) example
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gharkaguru
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Optional: when deploying to Kubernetes, set this to false to avoid automatic init
# INIT_DB_ON_START=true

